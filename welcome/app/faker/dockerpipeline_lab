pipeline {
    agent any

    environment {
        PYTHON_VERSIONS = "3.9,3.8"
        DOCKERHUB_CREDENTIALS = 'dockerhub-credentials'
        REPO_NAME = 'myimages'
        IMAGE_NAME = 'mypython_image'
    }

    stages {
        stage('Set Up Matrix') {
            steps {
                script {
                    // Convert the string of versions into a list
                    PYTHON_VERSION_LIST = PYTHON_VERSIONS.split(',')
                }
            }
        }

        stage('Clone Repository') {
            steps {
                git branch: 'jenkins-workshop', url: 'https://github.com/MoranDanino/devopshift-welcome.git'
            }
        }

        stage('Install Dependencies') {
            agent {
                docker {
                    image 'python:3.9'
                    args '-v $HOME/.cache/pip:/root/.cache/pip'
                }
            }
            steps {
                sh "pip install faker"
            }
        }

        stage('Test Application') {
            steps {
                script {
                    for (version in PYTHON_VERSION_LIST) {
                        stage("Test with Python ${version}") {
                            agent {
                                docker {
                                    image "python:${version}"
                                    reuseNode true
                                }
                            }
                            steps {
                                sh 'python app.py'
                            }
                        }
                    }
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                script {
                    for (version in PYTHON_VERSION_LIST) {
                        stage("Build Image for Python ${version}") {
                            sh """
                                docker build --build-arg PYTHON_VERSION=${version} -t ${REPO_NAME}:${version} .
                            """
                        }
                    }
                }
            }
        }

        stage('Push to DockerHub') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', env.DOCKERHUB_CREDENTIALS) {
                        for (version in PYTHON_VERSION_LIST) {
                            stage("Push Image for Python ${version}") {
                                def appImage = docker.image("${REPO_NAME}:${version}")
                                appImage.push()
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution completed.'
        }
    }
}
