pipeline {
    agent {
        docker {
            image 'python:3.10'
            args '--privileged -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('docker-hub-creds')
        DOCKER_REGISTRY = 'morandan7'
        REPO_NAME = 'fe-exam'  // Change to 'be-exam' for backend pipeline
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        
    }
    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'workshop/argo-jenkins-exam', url: 'https://github.com/MoranDanino/devopshift-welcome.git'
            }
        }

        stage('Lint & Security Scan'){
            parallel{
                stage('Flake8 Linting') {
                    steps {
                        sh 'pip install flake8'
                        sh 'flake8 . || true'
                    }
                }
                
                stage('Bandit Security Scan') {
                    steps {
                        sh 'pip install bandit'
                        sh 'bandit -r . || true'  
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'ls -l'
                sh 'ls -l'
                sh 'git status'
                sh 'git branch'
                sh 'find . -type d'
                sh 'cd exam-code/docker/fe && pip install -r requirements.txt' 
            }
        }

        stage('Build Docker Image'){
            steps {
                dir('fe') {
                    script {
                        sh 'docker build -t ${DOCKER_REGISTRY}/${REPO_NAME}:${IMAGE_TAG} .'
                        sh 'docker tag ${DOCKER_REGISTRY}/${REPO_NAME}:${IMAGE_TAG} ${DOCKER_REGISTRY}/${REPO_NAME}:${IMAGE_TAG}'
                    }
                }
            }
        }

        // stage('Run Tests in Container'){
        //     steps{
        //         sh 'docker run --rm ${DOCKER_REGISTRY}/${REPO_NAME}:${IMAGE_TAG} pytest tests/'
        //     }
        // }








    }

    post {
        always {
            echo 'Cleaning up workspace'
            deleteDir()
        }
        failure {
            echo 'Failed'
        }
        success {
            echo 'Success'
        }
    }

}
